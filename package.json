{
  "name": "aivore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIVORE — bilingual (Arabic/English) AI image and video generation platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "node --conditions=react-server ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/worker.ts",
    "admin": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/admin.ts",
    "setup:fal": "tsx --conditions=react-server scripts/setup-fal.ts",
    "check:fal": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-fal.ts",
    "setup:firebase": "tsx --conditions=react-server scripts/setup-firebase.ts",
    "check:storage": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-storage.ts",
    "migrate:media": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-media.ts",
    "format": "prettier --write .",
    "docker:build": "docker build -t aivore:local .",
    "backup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backup.mjs",
    "restore": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/restore.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google-cloud/storage": "^8.4.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gifenc": "^1.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
