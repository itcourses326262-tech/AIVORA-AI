# AIVORE configuration. Copy to `.env.local` (or `.env`) and adjust.
# Every variable is optional in development; the app runs with the Demo (mock) provider and no keys.

# ---- App --------------------------------------------------------------------------------------
# Public base URL. Used for the same-origin (CSRF) check and for absolute links.
APP_URL=http://localhost:3000
# SQLite file. Use ":memory:" only in tests.
DATABASE_PATH=./data/aivore.db
# Pepper for hashing session tokens and API keys. REQUIRED (>= 32 chars) when NODE_ENV=production;
# in development a built-in default is used with a warning. Generate one with: openssl rand -hex 32
SESSION_SECRET=
LOG_LEVEL=info
# Trust X-Forwarded-For for the client IP (rate limits, logs). Enable only behind a reverse proxy
# you control (it must APPEND to X-Forwarded-For); otherwise clients could spoof their address.
# With false, the app cannot tell clients apart: signed-in users are still limited per account, but
# anonymous visitors share one (larger) budget per route, and a production server that receives
# forwarding headers logs a warning once. Set true behind nginx, Caddy, Traefik, a CDN or a PaaS.
TRUST_PROXY=false
# With TRUST_PROXY=true: how many trusted reverse proxies sit in front of the app (each one appends
# the address it saw to X-Forwarded-For). The client is the entry that many hops from the right.
TRUSTED_PROXY_HOPS=1
# DANGER: turns ALL rate limits off (login, register, API). Only for end-to-end and load tests, so
# that Playwright can create many users from one address. A loud warning is logged at start-up.
RATE_LIMIT_DISABLED=false

# ---- Company details (shown on the legal pages: terms, privacy, refunds, acceptable use) -------
# The legal pages are DRAFTS for your lawyer to review (see src/lib/legal.ts, `LEGAL_DRAFT`). They
# never invent company facts: while a value is blank the page shows a highlighted placeholder.
# Use the registered name and details exactly as they appear on your commercial registration.
COMPANY_NAME=
COMPANY_ADDRESS=
# Commercial registration (CR) number.
COMPANY_CR_NUMBER=
# VAT registration number.
VAT_NUMBER=
# Legal, privacy and abuse-report mailbox. A single plain address (no name, no extra recipients).
CONTACT_EMAIL=
# Customer support, billing and refund mailbox.
SUPPORT_EMAIL=

# ---- Storage ----------------------------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/media
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, ...), used when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and other path-style endpoints.
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SEC=900

# ---- Generation providers ---------------------------------------------------------------------
# Demo models that generate placeholder images and a "motion preview" GIF without any API key.
# Set to false in production once real provider keys exist.
ENABLE_MOCK_PROVIDER=true
OPENAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
# Cost protection. The most credits that may be committed to generations on PAID providers (fal,
# OpenAI, Replicate; never the Demo provider) per rolling 24 hours, across all users. When a new
# request would exceed it, creating the generation fails with 503 `service_busy` and Retry-After.
# Failed and canceled generations are refunded and do not count; deleting a finished generation (or
# the account) does NOT give its share back, the provider billed it. 0 = no limit (default).
DAILY_UPSTREAM_BUDGET_CREDITS=0

# ---- Prompt enhancer --------------------------------------------------------------------------
# auto | openai | anthropic | heuristic. "auto" picks an LLM when a key exists, else heuristic.
PROMPT_ENHANCER=auto
PROMPT_ENHANCER_OPENAI_MODEL=gpt-4.1-mini
PROMPT_ENHANCER_ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# ---- Accounts & credits -----------------------------------------------------------------------
SIGNUP_ENABLED=true
# Credits granted to every new account.
SIGNUP_BONUS_CREDITS=50
# Comma-separated emails that become admins when they register. With confirmation required they
# are promoted instead by a password reset, or when the link is confirmed from a browser signed in
# to that account; otherwise use `npm run admin -- set-role`.
ADMIN_EMAILS=

# ---- Email & account safety -------------------------------------------------------------------
# Outgoing email (verification, password reset, notices). Either one URL ...
#   SMTP_URL=smtp://user:password@smtp.example.com:587     (smtps:// = implicit TLS, port 465)
# ... or the parts below (set one form, not both). Without SMTP, messages are NOT sent: they are
# written to an "outbox" (the log notice names it; a JSON-lines file next to DATABASE_PATH), so the
# whole flow works on a laptop with zero configuration. Never run production like that.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# true = TLS from the first byte (port 465); false = STARTTLS when the server offers it.
SMTP_SECURE=false
# The From header, e.g. AIVORE <no-reply@example.com>. REQUIRED once SMTP is configured.
EMAIL_FROM=
# auto = required exactly when SMTP is configured (off otherwise, so a fresh checkout still works);
# required = new accounts get the signup bonus and may create generations only after confirming
#   their address; off = never ask. "required" needs SMTP in production.
EMAIL_VERIFICATION=auto
# Extra throwaway-mail domains refused at sign-up (comma separated), on top of the built-in list.
DISPOSABLE_EMAIL_DOMAINS=
# Accounts one client address may create per rolling 24 hours (0 = no cap). Deleted accounts still
# count for their first day. Needs TRUST_PROXY=true to tell clients apart; without it all visitors
# share one 200x larger budget.
# Behind a reverse proxy also set TRUST_PROXY=true for "forgot password": without it every visitor
# shares one budget of 300 requests an hour, and a script can use it up for everybody.
SIGNUPS_PER_IP_PER_DAY=5

# ---- Billing (credit packs and monthly plans, paid in Saudi riyals through Moyasar) -----------
# auto    = Moyasar in production when MOYASAR_SECRET_KEY is set (billing is OFF in production
#           without it); the in-process fake "mock" checkout page everywhere else
# moyasar = always Moyasar (use this with sk_test_ keys to try the sandbox on your laptop)
# mock    = the fake checkout. REFUSED in production: it would hand out credits for a click.
# off     = nothing can be bought
BILLING_GATEWAY=auto
# Moyasar dashboard > Settings > API keys. The hosted checkout page keeps card data away from this
# app. Live keys (sk_live_/pk_live_) are refused outside production, test keys inside it.
MOYASAR_SECRET_KEY=
# Not used by the hosted checkout; validated so a live key cannot slip into development.
MOYASAR_PUBLISHABLE_KEY=
# Create a webhook in the Moyasar dashboard for https://<APP_URL>/api/v1/billing/webhooks/moyasar
# and set its secret token to this value (>= 16 characters, e.g. openssl rand -hex 24). Without it
# every webhook is rejected: payments are still confirmed when the buyer returns or by the
# background reconciliation (a minute or so), but refunds and chargebacks are then only noticed by
# the periodic re-check of paid orders (every few hours). Behind a reverse proxy also set
# TRUST_PROXY=true, otherwise every caller shares one address budget on the webhook and return URLs.
# Operator commands that touch the real gateway (refund-order, settle-order) run in production mode: NODE_ENV=production npm run admin -- refund-order <order id>
MOYASAR_WEBHOOK_SECRET=
# Official API. Must be an https URL on moyasar.com (it receives the secret key).
MOYASAR_API_BASE=https://api.moyasar.com/v1
# DANGER: allow live keys outside production / test keys in production (a staging deployment).
MOYASAR_ALLOW_LIVE_IN_DEV=false
MOYASAR_ALLOW_TEST_IN_PRODUCTION=false
# VAT included in every price (Saudi Arabia: 15). Stored on each order for the tax invoice.
VAT_RATE_PERCENT=15

# ---- Worker -----------------------------------------------------------------------------------
# inline   = job runner inside the Next.js process (default, zero setup)
# external = run `npm run worker` as a separate process
# off      = no runner (tests)
WORKER_MODE=inline
WORKER_CONCURRENCY=2
# Maximum queued + processing generations per user.
MAX_ACTIVE_PER_USER=4
MAX_ATTEMPTS=3
GENERATION_TIMEOUT_SEC_IMAGE=180
GENERATION_TIMEOUT_SEC_VIDEO=900

# ---- Uploads & moderation ---------------------------------------------------------------------
MAX_UPLOAD_MB=10
# Extra comma-separated blocked terms, in addition to the built-in list.
MODERATION_BLOCKLIST=
# none | openai (uses OPENAI_API_KEY)
MODERATION_PROVIDER=none
